END

/////////////////////////////////////////////////////////////////////////////
// 登录后主对话框（好友列表）
IDD_MAIN_DIALOG DIALOGEX 0, 0, 280, 330
STYLE DS_SETFONT | DS_CENTER | WS_MINIMIZEBOX | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "MyQQ"
FONT 9, "微软雅黑", 0, 0, 0x1
