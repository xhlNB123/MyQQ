    PUSHBUTTON      "发文件",IDC_CHAT_SEND_FILE_BTN,236,7,52,16
    LISTBOX         IDC_CHAT_HISTORY,10,28,280,160,LBS_OWNERDRAWVARIABLE | LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_CHAT_INPUT,10,196,215,44,ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL
    DEFPUSHBUTTON   "发送",IDC_CHAT_SEND_BTN,232,196,58,44
END

/////////////////////////////////////////////////////////////////////////////
// 个性化设置对话框
IDD_PROFILE_DIALOG DIALOGEX 0, 0, 240, 210
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "个性化设置"
FONT 9, "微软雅黑", 0, 0, 0x1
BEGIN
    LTEXT           "账号：",IDC_STATIC,20,18,40,12
    LTEXT           "",IDC_PROFILE_ACCOUNT,70,18,150,12
    LTEXT           "昵称：",IDC_STATIC,20,38,40,12
    EDITTEXT        IDC_PROFILE_NICKNAME,70,36,150,14,ES_AUTOHSCROLL
    LTEXT           "性别：",IDC_STATIC,20,58,40,12
    COMBOBOX        IDC_PROFILE_GENDER,70,56,150,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "星座：",IDC_STATIC,20,78,40,12
    COMBOBOX        IDC_PROFILE_STAR,70,76,150,160,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "血型：",IDC_STATIC,20,98,40,12
    COMBOBOX        IDC_PROFILE_BLOOD,70,96,150,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "头像：",IDC_STATIC,20,118,40,12
    COMBOBOX        IDC_PROFILE_AVATAR,70,116,150,120,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "签名：",IDC_STATIC,20,138,40,12
    EDITTEXT        IDC_PROFILE_SIGNATURE,70,136,150,32,ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL
    DEFPUSHBUTTON   "保存",IDC_PROFILE_SAVE_BTN,70,180,60,20
    PUSHBUTTON      "取消",IDCANCEL,140,180,60,20
END

