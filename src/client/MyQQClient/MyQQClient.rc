    EDITTEXT        IDC_REG_ACCOUNT,70,18,120,14,ES_AUTOHSCROLL
    LTEXT           "密码：",IDC_STATIC,20,42,40,12
    EDITTEXT        IDC_REG_PASSWORD,70,40,100,14,ES_PASSWORD | ES_AUTOHSCROLL
    PUSHBUTTON      "显",IDC_REG_PWD_EYE,172,40,18,14
    LTEXT           "确认密码：",IDC_STATIC,20,64,45,12
    EDITTEXT        IDC_REG_PASSWORD2,70,62,100,14,ES_PASSWORD | ES_AUTOHSCROLL
    PUSHBUTTON      "显",IDC_REG_PWD2_EYE,172,62,18,14
    LTEXT           "昵称：",IDC_STATIC,20,86,40,12
    EDITTEXT        IDC_REG_NICKNAME,70,84,120,14,ES_AUTOHSCROLL
