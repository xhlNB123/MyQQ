    CONTROL         "",IDC_FRIEND_LIST,"SysListView32",LVS_REPORT | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,10,63,260,225
    DEFPUSHBUTTON   "打开聊天",IDC_OPEN_CHAT_BTN,10,298,58,22
    PUSHBUTTON      "好友申请 (0)",IDC_FRIEND_REQUESTS_BTN,73,298,68,22
    PUSHBUTTON      "个性化设置",IDC_PROFILE_BTN,146,298,65,22
    PUSHBUTTON      "设置",IDC_SETTINGS_BTN,216,298,54,22
END

/////////////////////////////////////////////////////////////////////////////
// 聊天对话框
IDD_CHAT_DIALOG DIALOGEX 0, 0, 300, 262
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "聊天"
FONT 9, "微软雅黑", 0, 0, 0x1
BEGIN
