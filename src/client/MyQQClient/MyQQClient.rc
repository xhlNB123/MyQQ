/////////////////////////////////////////////////////////////////////////////
// 好友申请列表
IDD_FRIEND_REQUESTS_DIALOG DIALOGEX 0, 0, 300, 235
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "好友申请"
FONT 9, "微软雅黑", 0, 0, 0x1
BEGIN
